# ---------------------------------------------------------------------------
# Copy to `.env`. Secrets and machine-specific overrides only.
#
#     cp .env.example .env
#
# Trip settings — dates, currencies, title, FX fallback, publishing — live in
# `trip.toml` instead, which is committed. Keeping them here meant the GitHub
# Pages build never saw them: `.env` is gitignored, so the deploy fell back to
# the defaults in app/config.py and editing this file changed the local
# dashboard only.
#
# Precedence, highest first: environment variables, this file, `trip.toml`,
# then the defaults in app/config.py. So anything set here still wins locally.
#
# Everything below is optional. With all of it blank the dashboard runs on
# data/expenses.csv if present, and the bundled sample data if not.
# ---------------------------------------------------------------------------

# --- secrets ---------------------------------------------------------------

# Splitwise personal API key, from https://secure.splitwise.com/apps
# NOTE: third-party API access requires an active Splitwise Pro subscription.
# Leave blank to use a CSV export (data/expenses.csv) or the bundled sample.
SPLITWISE_API_KEY=

# Only needed for "Pull latest" against a *private* repo. A public one is
# readable anonymously. Needs read access to repository contents.
GITHUB_TOKEN=

# --- machine-specific ------------------------------------------------------

# SQLite file for bookings / itinerary (the stuff Splitwise cannot store).
DATABASE_URL=sqlite:///./data/trip.db

# Pin which CSV export to read. Blank auto-detects the newest file in data/;
# "none" ignores data/ entirely and serves the bundled sample instead.
SPLITWISE_CSV_PATH=

# --- local overrides -------------------------------------------------------
#
# Uncomment to disagree with trip.toml on this machine only, without
# committing the difference.
#
# TRIP_START=2026-10-05
# TRIP_END=2026-10-17
# TRIP_CURRENCY=THB
# HOME_CURRENCY=INR
# FX_LIVE=false
# FX_RATES={"THB": 2.81, "USD": 94.94, "INR": 1.0}
# CACHE_TTL_SECONDS=120
# AUTO_SEED=true
