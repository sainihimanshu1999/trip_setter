# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Everything has a sane default except the API key.
# ---------------------------------------------------------------------------

# Splitwise personal API key.
# 1. Go to https://secure.splitwise.com/apps
# 2. "Register your application" (any name/URL, e.g. name "Trip Dashboard",
#    homepage http://localhost:8000)
# 3. Open the app's detail page and click to generate a personal API key.
# NOTE: Third-party API access requires an active Splitwise Pro subscription.
# Leave this blank to use CSV import or DEMO mode instead.
SPLITWISE_API_KEY=

# Which Splitwise group is the trip? Leave blank and the app auto-picks the
# group whose type is "trip", or you can set the numeric id explicitly.
# Visit /api/groups once running to list your groups and their ids.
SPLITWISE_GROUP_ID=

# ------------- CSV import (no API key or Pro subscription needed) -------------
# Export your group from the Splitwise website:
#   Group page → Settings gear → "Export as spreadsheet"
# Drop the .csv into data/ and it's auto-detected, or set the path explicitly.
# Priority: API key (live) → CSV file (csv) → demo data (demo).
SPLITWISE_CSV_PATH=

# Currency the trip is spent in, and the currency you want totals shown in.
TRIP_CURRENCY=THB
HOME_CURRENCY=INR

# Static FX fallback used when live rates are unavailable or disabled.
# Expressed as "how many units of HOME_CURRENCY per 1 unit of the key".
# Snapshot from 2026-10-23: 1 THB = 2.81 INR, 1 USD = 94.94 INR
FX_RATES={"THB": 2.81, "USD": 94.94, "EUR": 106.27, "INR": 1.0, "SGD": 74.26, "MYR": 23.24}

# Fetch live rates from frankfurter.dev (free, no key). Falls back to FX_RATES.
FX_LIVE=true

# Trip window. Expenses outside this range are still fetched but flagged.
TRIP_START=2026-10-05
TRIP_END=2026-10-17

# How long to cache Splitwise responses, in seconds. The API is rate limited,
# so keep this at 60s or higher during normal use.
CACHE_TTL_SECONDS=120

# SQLite file for bookings / itinerary (the stuff Splitwise cannot store).
DATABASE_URL=sqlite:///./data/trip.db

# Re-seed the itinerary on boot if the bookings table is empty.
AUTO_SEED=true
