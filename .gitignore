# Virtualenv and Python cruft
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Local config: may hold a Splitwise API key
.env

# Your bookings database
data/trip.db
data/trip.db-wal
data/trip.db-shm

# Splitwise exports. Ad-hoc exports stay local; data/expenses.csv is the one
# canonical file the site is built from and the upload button overwrites, so
# that single file is tracked on purpose.
data/*.csv
!data/expenses.csv
data/*.xlsx

.DS_Store

# Static build output (GitHub Actions rebuilds it)
dist/
