# Virtualenv and Python cruft
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Local config: may hold a Splitwise API key
.env

# Your bookings database
data/trip.db
data/trip.db-wal
data/trip.db-shm

# Splitwise exports. Ad-hoc exports stay local; data/expenses.csv is the one
# canonical file the site is built from and the upload button overwrites, so
# that single file is tracked on purpose.
data/*.csv
!data/expenses.csv
data/*.xlsx

# Superseded exports, kept locally so a changed total can be traced back to
# the file it came from. Must stay out of data/ itself: anything matching
# data/*.csv competes with expenses.csv to be auto-detected as newest.
data/archive/

# Booking documents held back from publishing.
#
# data/docs/<booking id>/ IS committed: those files are served by the GitHub
# Pages site, which anyone can read, and that is the point of marking a
# document published. data/docs/private/ is the other half of that choice and
# must never be committed - it holds the tickets and visas whose passport
# numbers and dates of birth should not be on the public internet.
data/docs/private/
data/docs/**/.*.part

.DS_Store

# Static build output (GitHub Actions rebuilds it)
dist/
